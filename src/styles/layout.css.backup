.app-shell {
  display: grid;
  grid-template-rows: 56px minmax(0, 1fr);
  height: 100vh;
  overflow: hidden;
  background: #101418;
  color: #e9edf2;
}

.app-layout {
  position: relative;
  display: grid;
  grid-template-columns: var(--sidebar-width) var(--sidebar-divider-width) minmax(0, 1fr) var(--environment-divider-width) var(--environment-panel-width);
  min-height: 0;
  overflow: hidden;
  transition: grid-template-columns var(--panel-transition-duration) ease, grid-template-rows var(--panel-transition-duration) ease;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  padding: 0 20px;
  background: #171c22;
  border-bottom: 1px solid #29323c;
}

.app-header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #edf3f8;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.app-header-mark {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  color: #111820;
  background: #6ee7b7;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 800;
}

.environment-selector {
  display: flex;
  height: 34px;
  align-items: center;
  gap: 7px;
  padding: 0 9px;
  color: #dbe5ee;
  background: #151b21;
  border: 1px solid #35404c;
  border-radius: 7px;
}

.environment-selector:hover { background: #202933; border-color: #475563; }
.environment-selector:focus-within { border-color: #5fa98b; box-shadow: 0 0 0 2px rgb(110 231 183 / 14%); }
.environment-globe { display: grid; width: 17px; height: 17px; color: #6ee7b7; }
.environment-globe svg { width: 100%; height: 100%; fill: none; stroke: currentcolor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
.environment-selector select { height: 100%; min-width: 74px; padding: 0 18px 0 0; color: inherit; appearance: auto; background: transparent; border: 0; cursor: pointer; font: inherit; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; outline: none; }
.environment-selector option { color: #dbe5ee; background: #151b21; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

.environment-panel { display: flex; min-width: 0; min-height: 0; flex-direction: column; overflow: hidden; background: #12171d; }
.environment-panel-divider { position: relative; z-index: 2; cursor: ew-resize; background: #151b22; }
.environment-panel-divider::after { position: absolute; top: 0; bottom: 0; left: 2px; width: 2px; background: #3d4b5a; border-radius: 999px; content: ''; transition: background 150ms ease, box-shadow 150ms ease; }
.environment-panel-divider:hover::after { background: #69e2b0; box-shadow: 0 0 8px rgb(105 226 176 / 65%); }
.environment-panel-header { display: flex; min-height: 64px; align-items: stretch; background: #171c22; border-bottom: 1px solid #29323c; }
.environment-tabs { display: flex; min-width: 0; flex: 1; align-items: stretch; gap: 0; padding: 0; overflow-x: auto; }
.environment-tab { min-width: max-content; height: 100%; flex: 1; padding: 0 10px; color: #94a2b2; background: transparent; border: 0; border-bottom: 2px solid transparent; cursor: pointer; font: inherit; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; white-space: nowrap; }
.environment-tab:hover, .environment-tab:focus-visible { color: #dce6ef; background: #202933; outline: none; }
.environment-tab.active { color: #6ee7b7; border-bottom-color: #6ee7b7; }
.collection-tabs{
    display:flex;
    width:100%;
    align-items:stretch;
    margin-bottom:5px;
    border-bottom:1px solid #29323c;
}

.collection-tab{
    flex:1;
    height:42px;
    background:transparent;
    border:none;
    border-bottom:2px solid transparent;
    color:#94a2b2;
    font-size:11px;
    font-weight:800;
    letter-spacing:.04em;
    cursor:pointer;
    transition:.18s;
}

.collection-tab:hover{
    background:#202933;
    color:#dce6ef;
}

.collection-tab.active{
    color:#6ee7b7;
    border-bottom:2px solid #6ee7b7;
}
.environment-panel-expand-handle { position: absolute; z-index: 5; top: 50%; right: 0; display: grid; width: 24px; height: 82px; place-items: center; padding: 0; color: #c7d0dc; background: #202933; border: 1px solid #3d4b5a; border-right: 0; border-radius: 7px 0 0 7px; cursor: pointer; font: inherit; font-size: 22px; line-height: 1; transform: translateY(-50%); }
.environment-panel-expand-handle:hover, .environment-panel-expand-handle:focus-visible { color: #6ee7b7; background: #293842; outline: none; }
.environment-collapse-handle, .sidebar-collapse-handle { position: absolute; z-index: 5; top: 50%; display: grid; width: 22px; height: 78px; place-items: center; padding: 0; color: #c7d0dc; background: #202933; border: 1px solid #3d4b5a; cursor: pointer; font: inherit; font-size: 20px; line-height: 1; transform: translateY(-50%); }
.sidebar-collapse-handle { left: var(--sidebar-handle-left); border-left: 0; border-radius: 0 7px 7px 0; }
.environment-collapse-handle { right: var(--environment-panel-width); border-right: 0; border-radius: 7px 0 0 7px; }
.environment-collapse-handle:hover, .environment-collapse-handle:focus-visible, .sidebar-collapse-handle:hover, .sidebar-collapse-handle:focus-visible { color: #6ee7b7; background: #293842; outline: none; }

.environment-panel-body{
    display:flex;
    flex-direction:column;

    min-height:0;
    height:100%;

    padding:14px 10px;

    overflow-y:auto;
    overflow-x:hidden;
}

.environment-panel-body h2 { margin: 0 4px 8px; color: #edf3f8; font-size: 15px; font-weight: 600; }

/* =========================================================
   ENVIRONMENT VARIABLES - COMPACT PROFESSIONAL STYLE
   ========================================================= */

.environment-variables-table {
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    border-collapse: collapse;
}

/* KEY / VALUE headings */
.environment-variables-table th {
    padding: 0 4px 5px;
    color: #8290a0;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
}

/* Key column */
.environment-variables-table th:nth-child(2),
.environment-variables-table td:nth-child(2) {
    width: 10qh;
}

/* Value column */
.environment-variables-table th:nth-child(3),
.environment-variables-table td:nth-child(3) {
    width: 22%;
}

/* Compact rows */
.environment-variables-table tr {
    height: 29px;
}

/* Reduce gap around each input */
.environment-variables-table td {
    padding: 2px 3px;
    border-top: 1px solid #28323c;
}

/* KEY + VALUE input boxes */
.environment-variables-table input:not([type='checkbox']) {
    width: 100%;
    min-width: 0;
    height: 25px;

    box-sizing: border-box;

    padding: 0 6px;

    font-size: 12px;
    line-height: 1.2;

    background: #151b21;
    color: #dbe5ee;

    border: 1px solid #2c3640;
    border-radius: 4px;

    outline: none;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Focus */
.environment-variables-table input:not([type='checkbox']):focus {
    border-color: #6ee7b7;
    background: #1a2129;
}

/* Checkbox */
.environment-variables-table input[type='checkbox'] {
    accent-color: #6ee7b7;
    cursor: pointer;
}



.variable-field {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 0;
}

/* Highlight layer */
.variable-field-overlay {
  position: absolute;
  inset: 0;

  z-index: 2;

  box-sizing: border-box;

  width: 100%;
  height: 100%;

  margin: 0;

  /* Match normal input padding */
  padding: 0 10px;

  overflow: hidden;

  pointer-events: none;

  color: #dbe5ee;

  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  letter-spacing: inherit;

  white-space: pre;

  word-spacing: normal;
  word-break: normal;
  overflow-wrap: normal;
}







/* Normal text in overlay */
.variable-field-text {
  color: #dbe5ee;
}

/* Variable exists in environment */
.variable-token.enabled {
  color: #6ee7b7;
}

/* Variable exists but disabled */
.variable-token.disabled {
  color: #8b97a4;
}

/* Variable does not exist */
.variable-token.undefined {
  color: #f38b91;
}




/* URL overlay */
.variable-field:not(.multiline) .variable-field-overlay {
  padding: 0 10px;

  display: flex;
  align-items: center;

  box-sizing: border-box;
}


/* Body overlay must exactly match JSON editor */
.variable-field.multiline .variable-field-overlay {
  padding: 11px;

  font-family: 'Cascadia Code', Consolas, monospace;
  font-size: 12px;
  line-height: 1.65;

  white-space: pre-wrap;
  word-break: normal;
  overflow-wrap: normal;

  tab-size: 4;
}


.variable-autocomplete { position: absolute; z-index: 40; top: calc(100% + 5px); left: 0; min-width: 170px; max-height: 210px; overflow-y: auto; padding: 4px; background: #1a222b; border: 1px solid #3d4b5a; border-radius: 7px; box-shadow: 0 10px 24px rgb(0 0 0 / 40%); }
.variable-autocomplete button { display: block; width: 100%; height: 30px; padding: 0 9px; color: #dce6ef; background: transparent; border: 0; border-radius: 4px; cursor: pointer; font: inherit; font-size: 12px; text-align: left; }
.variable-autocomplete button:hover, .variable-autocomplete button.active { color: #effbf5; background: #294039; }

.url-input.variable-field-input { height: 38px; padding: 0 10px; color: #e6edf5; background: #11161c; border: 1px solid #303a45; border-radius: 6px; }
.params-table .variable-field-input, .headers-table .variable-field-input { height: 34px; padding: 0 10px; color: #dbe5ee; background: #151b21; border: 1px solid #2c3640; border-radius: 5px; }
.authorization-input.variable-field-input { height: 38px; margin-top: 8px; padding: 0 11px; color: #dbe5ee; background: #151b21; border: 1px solid #2c3640; border-radius: 6px; }
.url-input.variable-field-input:focus, .json-editor.variable-field-input:focus, .params-table .variable-field-input:focus, .headers-table .variable-field-input:focus, .authorization-input.variable-field-input:focus { border-color: #4e8f77; }



.workspace {
  display: grid;
  grid-template-rows: minmax(220px, 1fr) 6px minmax(180px, 1fr);
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.workspace.custom-split { grid-template-rows: var(--request-height) 6px minmax(180px, 1fr); }

.sidebar {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 2px 2px;
  overflow-y: auto;
  background: #171c22;
}

.sidebar-divider {
  position: relative;
  z-index: 2;
  cursor: col-resize;
  background: #151b22;
}

.sidebar-divider::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 2px;
  width: 2px;
  background: #3d4b5a;
  border-radius: 999px;
  content: '';
  transition: background 150ms ease, box-shadow 150ms ease;
}

.sidebar-divider:hover::after { background: #69e2b0; box-shadow: 0 0 8px rgb(105 226 176 / 65%); }

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 6px 22px;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand-mark {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  color: #111820;
  background: #6ee7b7;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 800;
}

.sidebar-section-header{
    display:flex;
    justify-content:center;
    align-items:center;

    margin:0 0 8px;

    color:#99a5b4;
    font-size:15px;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;

    width:100%;
}

.sidebar-actions { display: flex; flex-direction: column; gap: 8px; margin-bottom: 8px; }
.new-collection-button,
.import-collection-button {
  width: 100%;
  height: 34px;
  padding: 0 10px;
  color: #c7d0dc;
  background: #222a33;
  border: 1px solid #35404c;
  border-radius: 7px;
  cursor: pointer;
  font: inherit;
}

.new-collection-button:hover,
.import-collection-button:hover { background: #2a3440; border-color: #475563; }

.collection-list{
display:flex;
flex-direction:column;
gap:2px;
padding:0;
margin:0;
}

.collection-group{
margin-bottom:0px;
}
.sidebar-row {
  position: relative;

  display: flex;
  width: 100%;
  min-width: 0;
  height: 46px;

  align-items: center;
  gap: 8px;

  padding: 0 10px;

  color: #b6c1cd;
  border-radius: 0;

  cursor: pointer;
  font-size: 14px;

  outline: none;

  transition:
    background 150ms ease,
    color 150ms ease;
}
.sidebar-row:hover, .sidebar-row:focus-visible { color: #edf3f8; background: #222b35; }
.sidebar-row.selected { color: #f5f8fb; background: #2a3642; box-shadow: inset 2px 0 #6ee7b7; }
.collection-row{
height:24px;
padding:2px 8px;
display:flex;
align-items:center;
gap:6px;
}

.request-row{
display:flex;
align-items:center;
padding-left:28px;
height:24px;
padding:2px 10px;
gap:8px;
border-radius:0px;
margin:0;
}
.sidebar-row-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.collection-folder { flex: 0 0 auto; color: #eabf72; font-size: 14px; }
.collection-toggle {
  display: grid;
  width: 20px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  padding: 0;
  color: #8492a1;
  background: transparent;
  border: 0;
  border-radius: 4px;
  cursor: pointer;
  font: inherit;
  font-size: 17px;
}
.collection-toggle:hover { color: #dbe5ee; background: #303b47; }
.method-badge{
height:16px;
min-width:34px;
font-size:9px;
padding:0 6px;
}
.method-post { color: #6fc9ff; }
.method-put { color: #f1bf71; }
.method-patch { color: #c79bff; }
.method-delete { color: #f38b91; }

/* =========================================================
   ACTION MENU
   ========================================================= */




/* Horizontal three dots */
.action-menu-dots {
  display: block;

  font-family: Arial, sans-serif;
  font-size: 22px;
  font-weight: 700;
  line-height: 18px;

  letter-spacing: 1px;

  color: currentColor;
}

/* Show menu when row is hovered */
.sidebar-row:hover .action-menu-trigger,
.sidebar-row:focus-within .action-menu-trigger,
.action-menu-trigger[aria-expanded='true'] {
  opacity: 1;
}

/* Hover / active state */
.action-menu-trigger:hover,
.action-menu-trigger[aria-expanded='true'] {
  color: #f0f5f9;
  background: #35414d;
}

/* =========================================================
   ACTION MENU POPUP
   ========================================================= */

.action-menu-popover {
  position: absolute;

  top: calc(100% + 4px);
  right: 0;

  z-index: 50;

  width: 174px;

  padding: 5px;

  background: #1a222b;

  border: 1px solid #384552;
  border-radius: 8px;

  box-shadow: 0 12px 26px rgb(0 0 0 / 34%);
}

.action-menu-popover button {
  display: block;

  width: 100%;
  height: 34px;

  padding: 0 10px;

  color: #d9e2eb;
  background: #422a30;

  border: 0;
  border-radius: 5px;

  cursor: pointer;

  font: inherit;
  font-size: 14px;

  text-align: left;
}

.action-menu-popover button:hover,
.action-menu-popover button:focus-visible {
  background: #303c48;
  outline: none;
}

.action-menu-popover button:disabled {
  color: #6b7786;
  cursor: not-allowed;
  opacity: 0.7;
}

.action-menu-popover button.destructive {
  color: #f09a9f;
}

.action-menu-popover button.destructive:hover,
.action-menu-popover button.destructive:focus-visible {
  color: #ffc0c4;
  background: #422a30;
}

.history-section-header { margin-top: 12px; }
.history-controls { display: flex; flex-direction: column; gap: 6px; margin: 0 6px 8px; }
.history-filter{
height:32px;
font-size:13px;
}
.history-search{
height:32px;
font-size:13px;
}

.history-filter:focus { border-color: #4e8f77; }
.history-section { display: flex; flex-direction: column; gap: 4px; margin: 0 0 10px; }
.history-row{
height:30px;
padding:2px 8px;
gap:8px;
margin:0;
}
.history-summary { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 2px; }
.history-meta { color: #768491; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-favorite { display: grid; width: 24px; height: 24px; place-items: center; padding: 0; color: #8fa0b3; background: transparent; border: 0; border-radius: 999px; font-size: 15px; cursor: pointer; }
.history-favorite.active { color: #f4ca64; }
.history-favorite:hover { background: #26313b; }
.history-star { color: #f4ca64; font-size: 12px; }
.history-empty { padding: 8px 6px; color: #758393; font-size: 11px; }
.clear-history-button { margin: 4px 6px 0; padding: 8px 10px; color: #9be8c5; background: #1d3029; border: 0; border-radius: 5px; cursor: pointer; font: inherit; font-size: 12px; }
.clear-history-button:hover { background: #264534; }

.request-panel,
.response-panel { min-width: 0; padding: 18px 20px; }

.request-panel { min-height: 0; overflow-x: hidden; overflow-y: auto; border-bottom: 1px solid #29323c; }
.empty-request-state { padding: 32px 0; color: #758393; font-size: 13px; }

.workspace-divider {
  position: relative;
  z-index: 1;
  height: 6px;
  cursor: row-resize;
  background: #151b22;
}

.workspace-divider::after {
  position: absolute;
  top: 2px;
  right: 0;
  left: 0;
  height: 2px;
  background: #3d4b5a;
  border-radius: 999px;
  content: '';
  transition: background 150ms ease, box-shadow 150ms ease;
}

.workspace-divider:hover::after { background: #69e2b0; box-shadow: 0 0 8px rgb(105 226 176 / 70%); }

.request-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.request-title { min-width: 0; margin: 0; overflow: hidden; font-size: 15px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.request-dot { width: 7px; height: 7px; border-radius: 50%; background: #f0b65d; }

.request-bar {
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr) 95px;
  gap: 6px;
  padding: 5px;
  background: #1a2027;
  border: 1px solid #303a45;
  border-radius: 10px;
}

.method-select,
.url-input {
  min-width: 0;
  height: 38px;
  color: #e6edf5;
  background: #11161c;
  border: 1px solid #303a45;
  border-radius: 6px;
  font: inherit;
}

.method-select { padding: 0 10px; color: #6ee7b7; font-size: 12px; font-weight: 800; }
.url-input { padding: 0 10px; font-size: 13px; outline: none; }
.url-input:focus { border-color: #5fa98b; }

.send-button {
  color: #09261d;
  background: #6ee7b7;
  border: 0;
  border-radius: 6px;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
}

.send-button:hover { background: #8aefc7; box-shadow: 0 2px 8px rgb(110 231 183 / 22%); }
.send-button:disabled { cursor: wait; opacity: 0.7; }

.tabs {
  display: flex;
  gap: 18px;
  margin-top: 16px;
  border-bottom: 1px solid #29323c;
}

.tab-button {
  position: relative;
  padding: 0 1px 9px;
  color: #8793a1;
  background: none;
  border: 0;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
}

.tab-button:hover { color: #cbd6e0; }
.tab-button.active { color: #eaf0f6; }
.tab-button.active::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: #6ee7b7; content: ''; }

.body-editor-area { padding-top: 14px; }
.body-label { display: block; margin-bottom: 9px; color: #9ba8b7; font-size: 12px; }

.json-editor,
.response-body {
  box-sizing: border-box;
  width: 100%;
  color: #d3dfeb;
  background: #151b21;
  border: 1px solid #2c3640;
  border-radius: 8px;
  font-family: 'Cascadia Code', Consolas, monospace;
  font-size: 12px;
  line-height: 1.65;
}

.json-editor { height: 170px; padding: 11px; resize: vertical; outline: none; }
.json-editor:focus { border-color: #4e8f77; }
.tab-placeholder { padding: 34px 0; color: #758393; font-size: 13px; }
.input-error { margin: 8px 0 0; color: #f39a9a; font-size: 12px; }

.params-editor, .headers-editor { padding-top: 4px; }
.params-table, .headers-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.params-table th, .headers-table th { padding: 0 10px 9px; color: #8290a0; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-align: left; text-transform: uppercase; }
.params-table th:first-child, .params-table td:first-child, .headers-table th:first-child, .headers-table td:first-child { width: 74px; text-align: center; }
.params-table th:last-child, .params-table td:last-child, .headers-table th:last-child, .headers-table td:last-child { width: 44px; text-align: center; }
.params-table td, .headers-table td { padding: 5px; border-top: 1px solid #28323c; }
.params-table input[type='text'], .params-table td > input:not([type]), .headers-table input[type='text'], .headers-table td > input:not([type]) { width: 100%; }
.params-table input:not([type='checkbox']), .headers-table input:not([type='checkbox']) { height: 34px; padding: 0 10px; color: #dbe5ee; background: #151b21; border: 1px solid #2c3640; border-radius: 5px; outline: none; }
.params-table input:not([type='checkbox']):focus, .headers-table input:not([type='checkbox']):focus { border-color: #4e8f77; }
.params-table input[type='checkbox'], .headers-table input[type='checkbox'] { accent-color: #6ee7b7; cursor: pointer; }
.add-parameter-button, .delete-parameter-button, .add-header-button, .delete-header-button { border: 0; cursor: pointer; font: inherit; }
.add-parameter-button, .add-header-button { margin-top: 12px; padding: 8px 10px; color: #9be8c5; background: #1d3029; border-radius: 5px; font-size: 12px; }
.delete-parameter-button, .delete-header-button { width: 26px; height: 26px; color: #a6b1bd; background: transparent; border-radius: 4px; font-size: 19px; line-height: 1; }
.delete-parameter-button:hover, .delete-header-button:hover { color: #f3a0a0; background: #352529; }

.authorization-editor { max-width: 540px; padding-top: 18px; }
.authorization-fields { display: grid; gap: 9px; margin-top: 20px; }
.authorization-label { color: #9ba8b7; font-size: 12px; }
.authorization-select, .authorization-input { width: 100%; height: 38px; margin-top: 8px; padding: 0 11px; color: #dbe5ee; background: #151b21; border: 1px solid #2c3640; border-radius: 6px; outline: none; font: inherit; font-size: 13px; }
.authorization-select:focus, .authorization-input:focus { border-color: #4e8f77; }
.authorization-note { margin: 18px 0 0; color: #758393; font-size: 13px; }
.authorization-hint { margin: -2px 0 0; color: #758393; font-size: 11px; }

.response-panel { display: flex; flex-direction: column; min-height: 0; overflow: hidden; background: #12171d; }
.response-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.response-heading { margin: 0; font-size: 15px; font-weight: 600; }
.response-meta { display: flex; gap: 16px; color: #8997a6; font-size: 12px; }
.response-meta strong { color: #70d9a7; font-weight: 700; }
.response-body { flex: 1; min-height: 0; margin: 0; padding: 14px; overflow-x: hidden; overflow-y: auto; overflow-wrap: anywhere; white-space: pre-wrap; word-break: break-word; }
.response-error { color: #f39a9a; }

button, input, select, textarea { transition: background 150ms ease, border-color 150ms ease, box-shadow 150ms ease, color 150ms ease; }

.shared-dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  background: rgb(0 0 0 / 70%);
  backdrop-filter: blur(2px);
}
.shared-dialog-card {
  width: min(92vw, 430px);
  padding: 20px;
  background: #171c22;
  border: 1px solid #34424d;
  border-radius: 12px;
  box-shadow: 0 20px 48px rgb(0 0 0 / 45%);
}
.shared-dialog-title { margin: 0 0 8px; color: #f3f7fb; font-size: 16px; font-weight: 700; }
.shared-dialog-message { margin: 0 0 14px; color: #aeb9c6; font-size: 13px; line-height: 1.5; }
.shared-dialog-input {
  width: 100%;
  height: 38px;
  padding: 0 10px;
  color: #e8eef5;
  background: #11161c;
  border: 1px solid #313d48;
  border-radius: 7px;
  font: inherit;
  outline: none;
}
.shared-dialog-input:focus { border-color: #5fa98b; }
.shared-dialog-choice-list { display: flex; flex-direction: column; gap: 8px; }
.shared-dialog-choice {
  width: 100%;
  padding: 10px 12px;
  color: #dbe5ee;
  background: #1b232b;
  border: 1px solid #303b46;
  border-radius: 7px;
  cursor: pointer;
  font: inherit;
  text-align: left;
}
.shared-dialog-choice.active { color: #0f1720; background: #6ee7b7; border-color: #6ee7b7; }
.shared-dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
.shared-dialog-secondary,
.shared-dialog-primary {
  height: 36px;
  padding: 0 12px;
  border: 0;
  border-radius: 7px;
  cursor: pointer;
  font: inherit;
}
.shared-dialog-secondary { color: #d7e1ea; background: #222b35; }
.shared-dialog-primary { color: #09261d; background: #6ee7b7; font-weight: 700; }
.shared-dialog-secondary:hover { background: #2c3540; }
.shared-dialog-primary:hover { background: #8ef0c7; }

[data-tooltip] { position: relative; }
[data-tooltip]::after {
  position: absolute;
  z-index: 20;
  bottom: calc(100% + 7px);
  left: 50%;
  max-width: 260px;
  padding: 6px 8px;
  color: #e7edf4;
  background: #0d1218;
  border: 1px solid #35424e;
  border-radius: 5px;
  box-shadow: 0 6px 18px rgb(0 0 0 / 28%);
  content: attr(data-tooltip);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.25;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 3px);
  transition: opacity 150ms ease, transform 150ms ease;
  white-space: nowrap;
}
[data-tooltip]:hover::after, [data-tooltip]:focus-visible::after { opacity: 1; transform: translate(-50%, 0); transition-delay: 350ms; }

.is-resizing { overflow: hidden; user-select: none; }

@media (max-width: 980px) {
  .app-layout { grid-template-columns: var(--sidebar-width) var(--sidebar-divider-width) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) var(--environment-panel-width); }
  .environment-panel { grid-column: 1 / -1; grid-row: 2; border-top: 1px solid #29323c; border-left: 0; }
  .environment-panel-divider { display: none; }
  .environment-panel-header { min-height: 48px; }
  .environment-tabs { align-items: stretch; }
  .environment-tab { height: 48px; }
  .environment-panel-expand-handle { top: auto; right: 16px; bottom: 0; width: 82px; height: 24px; border-right: 1px solid #3d4b5a; border-bottom: 0; border-radius: 7px 7px 0 0; transform: none; }
  .request-panel, .response-panel { padding: 20px; }
  .request-bar { grid-template-columns: 82px minmax(0, 1fr) 78px; }
  .send-button { height: 38px; }
  .response-header { align-items: flex-start; flex-direction: column; }
}

.app-layout-main{
    min-width:0;
    min-height:0;
    width:100%;
    height:100%;
    overflow:hidden;
    display:flex;
    flex-direction:column;
}


.script-container{
    display:flex;
    height:200%;
    min-height:420px;
}

.script-sidebar{
    width:120px;
    border-right:1px solid #2c3640;
    display:flex;
    flex-direction:column;
    background:#11161c;
}

.script-sidebar button{
    height:30px;
    border:none;
    background:none;
    color:#aeb8c5;
    text-align:left;
    padding:0 5px;
    cursor:pointer;
    font-size:14px;
}

.script-sidebar button.active{
    color:#6ee7b7;
    background:#182128;
}

.script-main{
    flex:1;
    padding:4px;
}

.script-editor{
    width:100%;
    height:100%;
    min-height:400px;

    background:#11161c;
    color:#dbe5ee;

    border:1px solid #2c3640;
    border-radius:6px;

    resize:none;

    padding:14px;

    font-family:Consolas, monospace;
    font-size:14px;

    outline:none;
}


.environment-tab-wrapper{
    display:flex;
    align-items:center;
    gap:4px;
}

.environment-delete-button{
    background:none;
    border:none;
    color:#999;
    cursor:pointer;
    font-size:14px;
    padding:2px 4px;
}

.environment-delete-button:hover{
    color:#ff5555;
}




















.environment-menu{

    position:absolute;

    top:42px;

    right:0;

    width:230px;

    background:#1c222d;

    border:1px solid #323d4c;

    border-radius:8px;

    overflow:hidden;

    z-index:100;

    box-shadow:0 8px 24px rgba(0,0,0,.4);

}

.environment-menu button{

    width:100%;

    padding:12px 16px;

    background:none;

    border:none;

    color:white;

    text-align:left;

    cursor:pointer;

}

.environment-menu button:hover{

    background:#2d3948;

}

.environment-menu .danger{

    color:#ff6b6b;

}


.header-environment-group{

    display:flex;

    align-items:center;

    gap:10px;

    position:relative;

}

.header-environment-menu{

    width:34px;

    height:34px;

    border:none;

    background:transparent;

    color:#b7bec8;

    font-size:24px;

    cursor:pointer;

}

.header-environment-menu:hover{

    color:white;

}

.environment-table-wrapper{
    flex:1;
    overflow:auto;
    min-width:0;
    min-height:0;
}



/* Vertical scrollbar */
.environment-panel-body::-webkit-scrollbar{
    width:8px;
}

/* Horizontal scrollbar */
.environment-table-wrapper::-webkit-scrollbar{
    height:8px;
}

.environment-panel-body::-webkit-scrollbar-track,
.environment-table-wrapper::-webkit-scrollbar-track{
    background:#171c22;
}

.environment-panel-body::-webkit-scrollbar-thumb,
.environment-table-wrapper::-webkit-scrollbar-thumb{
    background:#3d4b5a;
    border-radius:8px;
}

.environment-panel-body::-webkit-scrollbar-thumb:hover,
.environment-table-wrapper::-webkit-scrollbar-thumb:hover{
    background:#556577;
}

.environment-table-wrapper::-webkit-scrollbar-corner{
    background:#171c22;
}

/* =========================================================
   COLLECTION / FOLDER ROW
   ========================================================= */

.collection-row {
  position: relative;
  width: 100%;
  min-width: 0;
}

/* Show the horizontal dots when hovering a collection/folder */
.collection-row:hover .action-menu-trigger,
.collection-row:focus-within .action-menu-trigger,
.collection-row .action-menu-trigger[aria-expanded='true'] {
  opacity: 1;
}


/* =========================================================
   COLLECTION / FOLDER / REQUEST TREE
   ========================================================= */

.tree-node {
  width: 100%;
  min-width: 0;
}

.tree-node-row {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  height: 28px;
  align-items: center;
  gap: 6px;
  padding: 2px 8px;
  color: #d8e0e9;
  border-radius: 0;
  cursor: pointer;
  box-sizing: border-box;
}

.tree-node-row:hover {
  color: #edf3f8;
  background: #222b35;
}

.tree-expand-icon {
  display: grid;
  width: 16px;
  height: 22px;
  flex: 0 0 16px;
  place-items: center;
  color: #8492a1;
  font-size: 14px;
}

.tree-folder-icon {
  display: inline-flex;
  width: 20px;
  flex: 0 0 20px;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.tree-folder-name {
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 550;
}

/* =========================================================
   REQUEST ROW
   ========================================================= */

.tree-request-row {
  width: 100%;
  height: 28px;
  min-width: 0;
  padding: 2px 8px;
  box-sizing: border-box;
}

.tree-request-content {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 100%;
  align-items: center;
  gap: 7px;
}

.tree-request-name {
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   THREE-DOT MENU
   ========================================================= */

.tree-row-actions {
  display: flex;
  flex: 0 0 18px;
  width: 18px;
  height: 20px;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}
/*
   IMPORTANT:
   The ActionMenu itself must stay in normal flex flow.
   Do NOT position it absolute.
*/
/* Action menu container */


/* Three-dot button */
.tree-row-actions .action-menu-trigger {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  padding: 0;
  color: #98a6b5;
  background: #0f335a;
  border: 0;
  border-radius: 5px;
  cursor: pointer;
  font: inherit;
  line-height: 1;
  opacity: 0;
}

/* Show dots when hovering the complete row */
.tree-node-row:hover .action-menu-trigger,
.tree-request-row:hover .action-menu-trigger,
.tree-row-actions:focus-within .action-menu-trigger,
.action-menu-trigger[aria-expanded='true'] {
  opacity: 1;
}

/* Horizontal dots */
.tree-row-actions .action-menu-trigger {
  font-family: Arial, sans-serif;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1;
}

/* Hover on dots */
.tree-row-actions .action-menu-trigger:hover,
.tree-row-actions .action-menu-trigger[aria-expanded='true'] {
  color: #f0f5f9;
  background: transparent;
}

/* =========================================================
   ACTION MENU POPUP
   ========================================================= */

.tree-row-actions .action-menu-popover {
  position: absolute;
  z-index: 50;
  top: calc(100% + 4px);
  right: 0;
  width: 174px;
  padding: 5px;
  background: #1a222b;
  border: 1px solid #384552;
  border-radius: 8px;
  box-shadow: 0 12px 26px rgb(0 0 0 / 34%);
}

.tree-row-actions .action-menu-popover button {
  display: block;
  width: 100%;
  height: 34px;
  padding: 0 10px;
   color: #ffc0c4;
  background: #422a30;
  border: 0;
  border-radius: 5px;
  cursor: pointer;
  font: inherit;
  font-size: 14px;
  text-align: left;
}

.tree-row-actions .action-menu-popover button:hover,
.tree-row-actions .action-menu-popover button:focus-visible {
  background: #303c48;
  outline: none;
}

.tree-row-actions .action-menu-popover button.destructive {
  color: #f09a9f;
}

.tree-row-actions .action-menu-popover button.destructive:hover,
.tree-row-actions .action-menu-popover button.destructive:focus-visible {
  color: #ffc0c4;
  background: #422a30;
}

/* =========================================================
   NESTED FOLDERS / REQUESTS
   ========================================================= */

.tree-node-children {
  width: 100%;
  min-width: 0;
}

.tree-folder-node > .tree-node-children {
  padding-left: 18px;
}

.tree-collection-node > .tree-node-children {
  padding-left: 0;
}


/* =========================================================
   TREE HIERARCHY / FOLDER INDENTATION
   ========================================================= */

.tree-node {
  width: 100%;
  min-width: 0;
}

/* Every level gets progressively indented */
.tree-node-children {
  width: 100%;
  min-width: 0;
  padding-left: 20px;
  box-sizing: border-box;
}

/* Collection itself stays at level 0 */
.tree-collection-node > .tree-node-children {
  padding-left: 20px;
}

/* Folder children get another level */
.tree-folder-node > .tree-node-children {
  padding-left: 20px;
}

/* =========================================================
   VERTICAL TREE GUIDE
   ========================================================= */

.tree-node-children {
  position: relative;
}

/* Vertical line showing parent -> children relationship */
.tree-node-children::before {
  content: '';
  position: absolute;
  left: 8px;
  top: 0;
  bottom: 0;

  width: 1px;
  background: #34404c;

  pointer-events: none;
}

/* =========================================================
   TREE ROW
   ========================================================= */

.tree-node-row,
.tree-request-row {
  position: relative;
  z-index: 1;
}

/* Small horizontal connector from vertical guide to node */
.tree-node-children > .tree-node::before {
  content: '';
  position: absolute;

  left: -12px;
  top: 14px;

  width: 10px;
  height: 1px;

  background: #34404c;
}

/* =========================================================
   DON'T DRAW GUIDE ON TOP-LEVEL COLLECTIONS
   ========================================================= */

.tree-collection-node > .tree-node-children::before {
  display: none;
}

/* =========================================================
   FOLDER / REQUEST ALIGNMENT
   ========================================================= */

.tree-folder-node,
.tree-request-node {
  position: relative;
  width: 100%;
  min-width: 0;
}

/* Folder row */
.tree-folder-node > .tree-node-row {
  width: 100%;
}

/* Request row */
.tree-request-node > .tree-request-row {
  width: 100%;
}

/* =========================================================
   COMPACT SIDEBAR â€” 70% SCALE
   ========================================================= */

.sidebar {
  font-size: 70%;
}

/* Collection / folder rows */
.sidebar .tree-node-row {
  height: 24px;
  min-height: 24px;
  padding: 1px 6px;
  gap: 4px;
}

/* Folder / collection names */
.sidebar .tree-folder-name {
  font-size: 12px;
}

/* Expand arrows */
.sidebar .tree-expand-icon {
  width: 13px;
  height: 20px;
  flex-basis: 13px;
  font-size: 11px;
}

/* Folder icons */
.sidebar .tree-folder-icon {
  width: 16px;
  flex-basis: 16px;
  font-size: 13px;
}

/* Request rows */
.sidebar .tree-request-row {
  height: 24px;
  min-height: 24px;
  padding: 1px 6px;
}

.sidebar .tree-request-content {
  gap: 5px;
}

.sidebar .tree-request-name {
  font-size: 12px;
}

/* HTTP method */
.sidebar .method-badge {
  height: 14px;
  min-width: 28px;
  padding: 0 4px;
  font-size: 8px;
}

/* Three dots */
.sidebar .action-menu-trigger {
  width: 24px;
  height: 24px;
  font-size: 16px;
}

/* Nested tree indentation */
.sidebar .tree-node-children {
  padding-left: 16px;
}

/* Sidebar tabs */
.sidebar .collection-tab {
  font-size: 12px;
  padding: 8px 12px;
}

/* History */
.sidebar .history-search,
.sidebar .history-filter {
  font-size: 12px;
}


/* =========================================================
   COMPACT COLLECTION TREE SPACING
   ========================================================= */

/* Folder + collection rows */
.tree-node-row {
  min-height: 20px !important;
  height: 20px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  margin: 0 !important;
}

/* Request rows */
.request-row {
  min-height: 20px !important;
  height: 20px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  margin: 0 !important;
}

/* Reduce spacing around children */
.tree-children {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

/* Reduce vertical gap between every tree item */
.tree-node {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

/* Request text */
.request-row .sidebar-row-title {
  line-height: 27px !important;
}

/* Folder / collection text */
.tree-node-row .sidebar-row-title {
  line-height: 30px !important;
}

/* Method badge */
.request-row .method-badge {
  margin-right: 8px !important;
}


/* =========================================================
   ENVIRONMENT VARIABLES - KEY / VALUE WIDTH
   ========================================================= */

.environment-variables-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
}

/* KEY column */
.environment-variables-table th:first-child,
.environment-variables-table td:first-child {
    width: 33.333%;
}

/* VALUE column */
.environment-variables-table th:nth-child(2),
.environment-variables-table td:nth-child(2) {
    width: 66.667%;
}

/* Smaller gap between KEY and VALUE */
.environment-variables-table td {
    padding: 3px 4px;
}

.environment-variables-table th {
    padding: 0 4px 6px;
}

/* Inputs */
.environment-variables-table input:not([type='checkbox']) {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

/* =========================================================
   REQUEST BODY TOOLBAR
   ========================================================= */

.body-editor-area {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    padding-top: 10px;
}

.body-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    margin-bottom: 8px;
}

.body-type-group {
    display: flex;
    align-items: center;
    gap: 8px;
}

.body-mode-select,
.body-format-select {
    height: 34px;
    padding: 0 30px 0 10px;
    color: #dbe5ee;
    background: #151b22;
    border: 1px solid #303b47;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
}

.body-mode-select {
    min-width: 130px;
}

.body-format-select {
    min-width: 105px;
}

.body-mode-select:hover,
.body-format-select:hover {
    border-color: #4e8f77;
}

.body-mode-select:focus,
.body-format-select:focus {
    outline: none;
    border-color: #6ee7b7;
}

.beautify-button {
    height: 34px;
    padding: 0 13px;
    color: #6ee7b7;
    background: transparent;
    border: 1px solid #35434e;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.beautify-button:hover {
    background: #1b2926;
    border-color: #6ee7b7;
}


.request-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.body-editor-area {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    overflow: hidden;
}

.json-editor {
  box-sizing: border-box;

  width: 100%;
  height: 170px;

  padding: 11px;

  resize: vertical;
  outline: none;

  font-family: 'Cascadia Code', Consolas, monospace;
  font-size: 12px;
  line-height: 1.65;
  letter-spacing: normal;

  white-space: pre-wrap;
  tab-size: 4;
}

.request-panel {
    overflow: hidden;
}

.json-editor {
    overflow: auto !important;
}



/* Dropdown */
.action-menu {
  position: relative !important;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  z-index: 10000 !important;
}

/* Three-dot trigger */
.action-menu-trigger {
  width: 24px !important;
  height: 24px !important;

  display: grid !important;
  place-items: center;

  padding: 0 !important;
  margin: 0;

  background: transparent !important;
  border: 0 !important;
  border-radius: 4px !important;

  color: #98a6b5;
  cursor: pointer;

  font-family: Arial, sans-serif !important;
  font-size: 20px !important;
  font-weight: 700;
  line-height: 1 !important;

  opacity: 0;
}

/* Show dots when row is hovered */
.tree-node-row:hover .action-menu-trigger,
.tree-request-row:hover .action-menu-trigger,
.tree-row-actions:hover .action-menu-trigger,
.action-menu:focus-within .action-menu-trigger,
.action-menu-trigger[aria-expanded="true"] {
  opacity: 1;
}

/* Dot hover */
.action-menu-trigger:hover,
.action-menu-trigger[aria-expanded="true"] {
  color: #ffffff !important;
  background: #35414d !important;
}


/* =========================================================
   DROPDOWN
   ========================================================= */

.action-menu-dropdown {
  position: absolute !important;

  top: calc(100% + 5px) !important;
  right: 0 !important;

  width: 150px !important;
  min-width: 150px !important;

  display: flex !important;
  flex-direction: column !important;

  padding: 4px !important;
  margin: 0 !important;

  background: #1a222b !important;

  border: 1px solid #384552 !important;
  border-radius: 7px !important;

  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55) !important;

  z-index: 99999 !important;
}


/* Every option must occupy its own row */
.action-menu-item {
  display: block !important;

  width: 100% !important;
  height: 30px !important;
  min-height: 30px !important;

  box-sizing: border-box !important;

  padding: 0 10px !important;
  margin: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 5px !important;

  color: #d9e2eb !important;

  font-family: inherit !important;
  font-size: 13px !important;
  font-weight: 500 !important;

  line-height: 30px !important;
  text-align: left !important;

  cursor: pointer !important;

  white-space: nowrap !important;
}


/* Menu item hover */
.action-menu-item:hover,
.action-menu-item:focus-visible {
  background: #303c48 !important;
  color: #ffffff !important;
  outline: none !important;
}


/* Delete / destructive action */
.action-menu-item.destructive {
  color: #f09a9f !important;
}

.action-menu-item.destructive:hover,
.action-menu-item.destructive:focus-visible {
  color: #ffc0c4 !important;
  background: #422a30 !important;
}


/* =========================================================
   TREE MENU MUST APPEAR ABOVE OTHER ROWS
   ========================================================= */

.tree-row-actions {
  position: relative !important;
  z-index: 10000 !important;
}

.tree-node-row,
.tree-request-row {
  position: relative;
  overflow: visible !important;
}

.tree-node-children {
  overflow: visible !important;
}

.collection-list,
.collection-group {
  overflow: visible !important;
}


/* When menu is open, make its row highest priority */
.tree-node-row:has(.action-menu-trigger[aria-expanded="true"]),
.tree-request-row:has(.action-menu-trigger[aria-expanded="true"]) {
  z-index: 100000 !important;
}


/* Don't let other rows cover an open menu */
.tree-node-row:hover,
.tree-request-row:hover {
  z-index: 1000;
}


/* =========================================================
   DRAG & DROP TREE
   ========================================================= */

.tree-node-row[draggable="true"],
.tree-request-row[draggable="true"] {
  cursor: grab;
}

.tree-node-row[draggable="true"]:active,
.tree-request-row[draggable="true"]:active {
  cursor: grabbing;
}

/*
 * Folder is the destination.
 * Highlight means:
 * "Drop here to move inside this folder."
 */
.tree-node-row.drop-inside {
  background: #263d36;
  box-shadow:
    inset 0 0 0 1px #6ee7b7;
}

/*
 * Request target - move before.
 */
.tree-request-row.drop-before {
  box-shadow:
    inset 0 2px 0 #6ee7b7;
}

/*
 * Request target - move after.
 */
.tree-request-row.drop-after {
  box-shadow:
    inset 0 -2px 0 #6ee7b7;
}

/*
 * Slight visual feedback while dragging.
 */
.tree-node-row[draggable="true"]:active,
.tree-request-row[draggable="true"]:active {
  opacity: 0.55;
}

/* VariableField multiline editor alignment */
.variable-field.multiline {
  position: relative;
  width: 100%;
  min-height: 0;
}

